<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover" />
<title>透明カンペ</title>
<link rel="manifest" href="manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="カンペ">
<meta name="theme-color" content="rgba(0,0,0,0)">
<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    height: 100%;
    /* iOSでのPWA全画面対応 */
    height: -webkit-fill-available;
  }

  body {
    min-height: 100%;
    min-height: -webkit-fill-available;
    background: transparent;
    font-family: 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: env(safe-area-inset-top, 12px) env(safe-area-inset-right, 12px) env(safe-area-inset-bottom, 12px) env(safe-area-inset-left, 12px);
    gap: 10px;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  /* ツールバー */
  .toolbar {
    display: flex;
    gap: 8px;
    align-items: center;
    width: 90%;
    max-width: 700px;
  }

  /* 透明度スライダー */
  .opacity-label {
    font-size: 11px;
    color: rgba(255,255,255,0.85);
    text-shadow: 0 1px 4px rgba(0,0,0,0.7);
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    border-radius: 2px;
    background: rgba(255,255,255,0.4);
    outline: none;
    flex: 1;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 1px 6px rgba(0,0,0,0.3);
    cursor: pointer;
  }

  .btn {
    padding: 5px 13px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 8px;
    background: rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.95);
    font-size: 12px;
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.2s;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    white-space: nowrap;
  }
  .btn:active {
    background: rgba(255,255,255,0.3);
  }

  /* フォントサイズボタン */
  .btn-sm {
    padding: 4px 9px;
    font-size: 15px;
    font-weight: bold;
    min-width: 32px;
    text-align: center;
  }

  /* メインテキストエリア */
  textarea {
    width: 90%;
    max-width: 700px;
    flex: 1;
    font-size: 22px;
    line-height: 1.75;
    padding: 18px 20px;
    border: 1.5px solid rgba(255,255,255,0.35);
    outline: none;
    border-radius: 16px;
    /* 背景色はJSで動的変更 */
    background: rgba(255,255,255,0.92);
    color: #111;
    resize: none;
    box-shadow:
      0 8px 32px rgba(0,0,0,0.18),
      0 1.5px 0 rgba(255,255,255,0.6) inset;
    transition: background 0.3s, font-size 0.2s;
    user-select: text;
    -webkit-user-select: text;
    letter-spacing: 0.02em;
    /* スクロールバー非表示（見た目スッキリ） */
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.15) transparent;
  }
  textarea::-webkit-scrollbar {
    width: 5px;
  }
  textarea::-webkit-scrollbar-track {
    background: transparent;
  }
  textarea::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.12);
    border-radius: 3px;
  }
  textarea::placeholder {
    color: rgba(0,0,0,0.3);
  }

  /* ダークモード */
  body.dark textarea {
    background: rgba(20,20,20,0.92);
    color: #eee;
    border-color: rgba(255,255,255,0.15);
  }
  body.dark textarea::placeholder {
    color: rgba(255,255,255,0.25);
  }

  /* 文字数カウンター */
  .count {
    font-size: 11px;
    color: rgba(255,255,255,0.7);
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    align-self: flex-end;
    width: 90%;
    max-width: 700px;
    text-align: right;
    padding-right: 2px;
  }
</style>
</head>
<body>

  <!-- ツールバー上段 -->
  <div class="toolbar">
    <span class="opacity-label">透明度</span>
    <input type="range" id="opacitySlider" min="0" max="95" value="92" step="1" oninput="updateOpacity(this.value)">
    <button class="btn btn-sm" onclick="changeFont(-2)">A−</button>
    <button class="btn btn-sm" onclick="changeFont(+2)">A＋</button>
    <button class="btn" onclick="toggleDark()">🌓</button>
    <button class="btn" onclick="clearMemo()">クリア</button>
  </div>

  <!-- メモエリア -->
  <textarea id="memo" placeholder="カンペをここに入力..." oninput="saveMemo(); updateCount()" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>

  <!-- 文字数 -->
  <div class="count" id="count">0 文字</div>

<script>
  const memo = document.getElementById('memo');
  const countEl = document.getElementById('count');
  let fontSize = 22;

  // 保存・復元
  function saveMemo() {
    try { localStorage.setItem('kanpe_text', memo.value); } catch(_) {}
  }
  function loadMemo() {
    try {
      const t = localStorage.getItem('kanpe_text');
      if (t) { memo.value = t; updateCount(); }
      const op = localStorage.getItem('kanpe_opacity');
      if (op !== null) { document.getElementById('opacitySlider').value = op; updateOpacity(op); }
      const fs = localStorage.getItem('kanpe_fontsize');
      if (fs) { fontSize = parseInt(fs); memo.style.fontSize = fontSize + 'px'; }
      if (localStorage.getItem('kanpe_dark') === '1') {
        document.body.classList.add('dark');
      }
    } catch(_) {}
  }

  function clearMemo() {
    if (confirm('カンペをクリアしますか？')) {
      memo.value = '';
      try { localStorage.removeItem('kanpe_text'); } catch(_) {}
      updateCount();
    }
  }

  function updateOpacity(val) {
    const opacity = (100 - parseInt(val)) / 100;
    const isDark = document.body.classList.contains('dark');
    if (isDark) {
      memo.style.background = `rgba(20,20,20,${0.05 + opacity * 0.87})`;
    } else {
      memo.style.background = `rgba(255,255,255,${0.05 + opacity * 0.90})`;
    }
    try { localStorage.setItem('kanpe_opacity', val); } catch(_) {}
  }

  function changeFont(delta) {
    fontSize = Math.max(12, Math.min(48, fontSize + delta));
    memo.style.fontSize = fontSize + 'px';
    try { localStorage.setItem('kanpe_fontsize', fontSize); } catch(_) {}
  }

  function toggleDark() {
    document.body.classList.toggle('dark');
    const isDark = document.body.classList.contains('dark');
    try { localStorage.setItem('kanpe_dark', isDark ? '1' : '0'); } catch(_) {}
    // 透明度を現在値で再適用
    updateOpacity(document.getElementById('opacitySlider').value);
  }

  function updateCount() {
    countEl.textContent = memo.value.length + ' 文字';
  }

  // 初期化
  loadMemo();
  updateCount();

  // PWA登録
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('sw.js').catch(console.error);
  }
</script>
</body>
</html>
